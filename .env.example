# ─── Frontend (Vite) ───────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
# URL da API em produção (ex.: https://api.kutekalink.com). Em dev usa proxy /api
VITE_API_URL=
# Mapas Leaflet — opcional se usar tiles pagos; OpenStreetMap funciona sem chave
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ─── Backend API ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://kutekalink.com,https://www.kutekalink.com

# Base de dados (MongoDB Atlas recomendado)
MONGODB_URI=

# Sessões JWT (gere uma string longa e aleatória)
JWT_SECRET=

# Google — mesmo Client ID do frontend; usado para validar tokens no servidor
GOOGLE_CLIENT_ID=

# OpenAI — descrições de anúncios, pesquisa em linguagem natural
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS S3 — upload de fotos dos anúncios
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email transacional (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Kuteka <noreply@kutekalink.com>

# Stripe — ÚLTIMO (substituir por gateway Kwanza quando definido)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
