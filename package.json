{
  "name": "kutekalink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace=kuteka-api",
    "build": "vite build && node scripts/copy-spa-fallback.js",
    "start:api": "npm run start --workspace=kuteka-api",
    "seed": "node backend/scripts/seed-listings.js",
    "mongo:host": "node scripts/set-mongo-host.js",
    "mongo:uri": "node scripts/set-mongo-uri.js",
    "aws:provision": "powershell -ExecutionPolicy Bypass -File scripts/aws-provision-kuteka.ps1",
    "mongo:provision": "powershell -ExecutionPolicy Bypass -File scripts/aws-provision-mongo-ec2.ps1",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "axios": "^1.9.0",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
