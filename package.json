{
  "name": "kuteka",
  "private": true,
  "version": "0.1.0",
  "description": "KEOS \u2014 Kuteka Engineering Operating System",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kuteka/web",
    "build": "node scripts/copy-prebuilt-dist.mjs",
    "build:turbo": "turbo run build",
    "build:static": "bash scripts/build-static-web.sh",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @kuteka/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "prepare": "husky || true",
    "build:full": "bash scripts/build-for-render.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "!(prebuilt)/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "!(prebuilt)/**/*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.3",
      "onFail": "ignore"
    }
  }
}
